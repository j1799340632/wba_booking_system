# Copy to .env and replace all database/Redis placeholders before running.
# Docker Compose reads this file only when explicitly passed via --env-file.
MYSQL_ROOT_PASSWORD=replace_with_mysql_root_password
MYSQL_PASSWORD=replace_with_mysql_app_password
REDIS_PASSWORD=replace_with_redis_password

# Optional integrations: supply your own credentials to use mail / Google Calendar.
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
